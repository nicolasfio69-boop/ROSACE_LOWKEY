{
  "$schema": "generated by the demo-setup skill — see .claude/skills/demo-setup and docs/CONFIG.md of AlexAnsart/demo-studio",

  "app": {
    "baseUrl": "https://holy-nice-impala.eur-1.aiven.app",
    "devCommand": "none: the demo is filmed on the live Aiven site (local alternative: npm run build && npm start)",
    "viewport": { "width": 1920, "height": 1080 }
  },

  "cursor": { "scale": 1.6, "color": "#0A0A0A" },

  "camera": { "padding": 0.22, "maxZoom": 1.7, "transitionSec": 0.72 },

  "speedup": { "toolWaitMax": 4, "preToolWaitMax": 2.5, "idleGapMax": 1.8, "idleGapMin": 3.5 },

  "frame": {
    "preset": "macos-light",
    "canvasWidth": 1920,
    "canvasHeight": 1080
  },

  "narration": {
    "provider": "elevenlabs",
    "voiceName": "Rachel",
    "modelId": "eleven_v3",
    "stability": 1.0,
    "apiKeyEnv": "ELEVENLABS_API_KEY"
  },

  "captions": { "enabled": true, "maxCharsPerLine": 60 },

  "output": { "dir": "demos" }
}
