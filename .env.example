# Optional server-only credentials. Copy to .env.local and restart.
# Manual examples and pasted company context work without any key.
CONTEXT_DEV_API_KEY=
AI_PROVIDER=featherless
FEATHERLESS_API_KEY=
# Choose a model ID available in your Featherless account; no model is auto-selected.
FEATHERLESS_MODEL=
# Optional legacy provider: set AI_PROVIDER=gemini explicitly to use these.
GEMINI_API_KEY=
GEMINI_MODEL=
